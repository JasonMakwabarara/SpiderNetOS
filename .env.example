# ──────────────────────────────────────────────
# SpiderNet OS v3.2 — Environment Configuration
# ──────────────────────────────────────────────

# Laravel Application
APP_NAME=SpiderNetOS
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# PostgreSQL (pgvector enabled)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=spidernet
DB_USERNAME=spidernet
DB_PASSWORD=spidernet

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Queue (Horizon)
QUEUE_CONNECTION=redis

# Broadcasting (Soketi)
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=spidernet
PUSHER_APP_KEY=spidernet-key
PUSHER_APP_SECRET=spidernet-secret
PUSHER_HOST=websocket
PUSHER_PORT=6001
PUSHER_SCHEME=http

# Inference Plane
INFERENCE_URL=http://inference:9000
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_ENABLED=1
OPENAI_API_KEY=

# DeepSeek via BytePlus ModelArk (primary hosted LLM provider)
# International host only — never the cn-beijing host in production.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
DEEPSEEK_ARK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_ARK_MODEL_PRO=deepseek-v4-pro

# OpenJarvis — background inference for Atlas (edge node)
# Set OPENJARVIS_URL to your edge OpenJarvis server for true local inference
OPENJARVIS_URL=
OPENJARVIS_API_KEY=
OPENJARVIS_BRIDGE_URL=http://openjarvis-bridge:8000
OPENJARVIS_ENABLED=true
FEATURE_ATLAS_OPENJARVIS=on
FEATURE_ATLAS_JARVIS_MORNING_DIGEST=on
FEATURE_ATLAS_JARVIS_DEEP_RESEARCH=on

# Partner outreach (affiliate recruitment): keep off here, enable per tenant with
# `php artisan feature set outreach.sending on --tenant=<uuid>`
FEATURE_OUTREACH_ENABLED=off
FEATURE_OUTREACH_SENDING=off
FEATURE_OUTREACH_INBOUND_POLL=off
FEATURE_OUTREACH_BOT_REPLIES=off
FEATURE_OUTREACH_AFFONSO_ACTIONS=off
FEATURE_OUTREACH_PROFILE_ENRICHMENT=off
FEATURE_OUTREACH_DIGEST=off
FEATURE_OUTREACH_FINDER_SYNC=off
FEATURE_OUTREACH_FINDER_WRITEBACK=off

# Dodo Payments (platform billing gateway — merchant of record)
DODO_ENABLED=false
DODO_MODE=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_RETURN_URL=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_ENTERPRISE=
DODO_PRICE_STARTER=1200
DODO_PRICE_GROWTH=4800

# Cost Governor
COST_CEILING_DEFAULT=50.00

# Fingerprint Cache
FINGERPRINT_CACHE_TTL_MINUTES=120

# Prompt Enhancer
SPIDERNET_PROMPT_ENHANCER_MODEL=gpt-4o-mini

# Adaptive Cost Estimation
COST_ESTIMATE_MAX_DRIFT_RATIO=0.75

# Atlas Cognitive Contract
ATLAS_TRUTH_ANCHOR_TOLERANCE=1.25
ATLAS_DEFAULT_STYLE=balanced

# Embedding
EMBEDDING_MODEL=gemma4
EMBEDDING_DIM=384

# Sanctum — explicit allowlist; no wildcards in production
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# CORS — explicit allowlist; wildcard is REJECTED in prod when supports_credentials=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_MAX_AGE=3600

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache
CACHE_DRIVER=redis

# Security headers (used by SecurityHeadersMiddleware)
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_REPORT_URI=

# Telephony — Voice AI Provider
# Supported: twilio, signalwire, vonage
TELEPHONY_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SECRET=
TWILIO_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK=

# SignalWire (Twilio-compatible, ~40% cheaper)
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_AUTH_TOKEN=
SIGNALWIRE_SPACE=  # e.g. example.signalwire.com
SIGNALWIRE_WEBHOOK_URL=
SIGNALWIRE_STATUS_CALLBACK=

# Vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=

# Voice AI Pipeline
VOICE_STREAMING_ENABLED=false
VOICE_STREAMING_STT_PROVIDER=deepgram
VOICE_STREAMING_TTS_PROVIDER=elevenlabs
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Atlas voice (plan D7 §7): no built-in voice. VOICE_DEFAULT_PERSONA is a slug from
# inference/voice_personas.yaml (seeded by `php artisan voice:sync-personas`); ELEVENLABS_VOICE_ID
# is only an explicit override for telephony streaming.
VOICE_DEFAULT_PERSONA=
ELEVENLABS_VOICE_ID=
FISH_AUDIO_API_KEY=
INTRON_API_KEY=
FEATURE_VOICE_ATLAS_SPEAK=off

# Enterprise self-serve registration
ENTERPRISE_SELF_SERVE_ENABLED=true
ENTERPRISE_AUTO_VERIFY_DOMAINS=true

# Enterprise sign-in methods (/api/enterprise/auth/*)
# Demo flows (demo SSO, WebAuthn stub, TOTP 000000, magic-link dev_link) —
# defaults ON outside production, keep OFF/unset in prod.
ENTERPRISE_DEMO_AUTH=
ENTERPRISE_TOTP_LOGIN_ENABLED=true
ENTERPRISE_MAGIC_LINK_EXPIRY_MINUTES=30
# Absolute sign-in page URL used in magic-link emails + SSO callback redirect
# (defaults to APP_URL + /sign-in). Magic-link delivery needs MAIL_* configured;
# with the default 'log' mailer the email lands in laravel.log.
ENTERPRISE_SIGNIN_URL=

# Agent-executed SOP steps (auto | inference | simulate)
SPIDERNET_AGENT_STEP_EXECUTION=auto
SPIDERNET_AGENT_STEP_COST_CEILING=0.25
SPIDERNET_NODE_STALE_MINUTES=15
INFERENCE_TOKEN=
