FROM python:3.11-slim
WORKDIR /app
COPY inference/ .
COPY intelligence/agents/voice_agent.py ./agents/voice_agent.py
COPY intelligence/tools/ ./tools/
COPY intelligence/atlas/mc_simulator.py ./intelligence/atlas/mc_simulator.py
RUN pip install fastapi uvicorn httpx
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "9000"]
