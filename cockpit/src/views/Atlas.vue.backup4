<template>
  <div class="atlas-container">
    <div class="page-header">
      <h1>🗣️ Atlas – General AI Assistant</h1>
      <p>I'm your AI Operating System assistant. I can help you create agents, manage flows, and answer questions about the platform.</p>
    </div>
    <div class="chat-wrapper">
      <div class="chat-messages" ref="messagesContainer">
        <div v-for="msg in messages" :key="msg.id" :class="['message', msg.role]">
          <div class="avatar">{{ msg.role === 'user' ? '👤' : '🗣️' }}</div>
          <div class="bubble" v-html="formatMessage(msg.content)"></div>
        </div>
        <div v-if="loading" class="message assistant"><div class="avatar">🗣️</div><div class="bubble typing">...</div></div>
      </div>
      <div class="chat-input-area">
        <div class="suggestions">
          <button v-for="s in suggestions" :key="s" @click="sendSuggestion(s)">{{ s }}</button>
        </div>
        <div class="input-group">
          <input v-model="inputMessage" @keyup.enter="sendMessage" placeholder='Try "create agent" or "create flow"' />
          <button @click="sendMessage" class="send-btn">Send</button>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import api from '../services/api'

export default {
  data() {
    return {
      messages: [],
      inputMessage: '',
      loading: false,
      suggestions: ['create agent', 'create flow', '/agents', '/help'],
      // State for interactive creation
      creatingAgent: false,
      creatingFlow: false,
      addingAction: false,
      agentStep: 0,
      flowStep: 0,
      actionStep: 0,
      agentData: { name: '', role: '', description: '', capabilities: [] },
      flowData: { name: '', description: '', trigger: 'manual', actions: [] },
      actionData: { type: '', to: '', webhook: '', message: '', subject: '' },
      waitingForActionType: false,
      waitingForActionDetails: false
    }
  },
  mounted() {
    this.messages.push({
      id: Date.now(),
      role: 'assistant',
      content: this.getWelcomeMessage()
    })
  },
  methods: {
    getWelcomeMessage() {
      return `👋 **Hello! I'm Atlas, your AI Operating System assistant.**

I can help you:
• Create task-specific agents (Sales, Support, Data Analyst, etc.)
• Build automated workflows
• Monitor your AI workspace
• Answer questions about SpiderNetOS

**Try these commands:**
• \`create agent\` - I'll guide you step by step
• \`create flow\` - I'll guide you step by step
• \`/agents\` - List all agents
• \`/flows\` - List all flows
• \`/help\` - Show this help`
    },
    formatMessage(content) {
      return content.replace(/\n/g, '<br>')
    },
    scrollToBottom() {
      this.$nextTick(() => {
        const container = this.$refs.messagesContainer
        if (container) container.scrollTop = container.scrollHeight
      })
    },
    async sendSuggestion(suggestion) {
      this.inputMessage = suggestion
      await this.sendMessage()
    },
    async sendMessage() {
      if (!this.inputMessage.trim()) return
      
      const userMsg = { id: Date.now(), role: 'user', content: this.inputMessage }
      this.messages.push(userMsg)
      const command = this.inputMessage
      this.inputMessage = ''
      this.loading = true
      this.scrollToBottom()
      
      try {
        if (this.creatingAgent || this.creatingFlow || this.addingAction) {
          const response = await this.handleCreationStep(command)
          this.messages.push({ id: Date.now(), role: 'assistant', content: response })
        } else {
          const response = await this.processCommand(command)
          this.messages.push({ id: Date.now(), role: 'assistant', content: response })
        }
      } catch(err) {
        console.error('Error:', err)
        this.messages.push({ id: Date.now(), role: 'assistant', content: `❌ Error: ${err.response?.data?.message || err.message}` })
      } finally {
        this.loading = false
        this.scrollToBottom()
      }
    },
    
    async handleCreationStep(text) {
      if (this.creatingAgent) {
        return await this.handleAgentCreation(text)
      } else if (this.creatingFlow) {
        return await this.handleFlowCreation(text)
      } else if (this.addingAction) {
        return await this.handleActionCreation(text)
      }
      return "I'm here to help!"
    },

    // AGENT CREATION
    async handleAgentCreation(text) {
      const steps = [
        { prompt: "🤖 **Let's create an agent!**\n\nPlease enter the **Agent Name**:", field: 'name' },
        { prompt: "What is the **Role / Purpose**? (e.g., Sales Assistant, Support Bot, Data Analyst)", field: 'role' },
        { prompt: "Add a **Description** for this agent:", field: 'description' },
        { prompt: "Enter **Capabilities** (comma separated, e.g., chat, data_analysis, memory_access) or type 'skip':", field: 'capabilities' }
      ]

      if (this.agentStep === 0) {
        this.agentData = { name: '', role: '', description: '', capabilities: [] }
      }

      if (this.agentStep < steps.length) {
        const step = steps[this.agentStep]
        if (text.trim() === 'cancel') {
          this.creatingAgent = false
          this.agentStep = 0
          return "❌ Agent creation cancelled."
        }
        
        if (step.field === 'capabilities') {
          this.agentData.capabilities = text.trim() === 'skip' ? [] : text.split(',').map(s => s.trim())
        } else {
          this.agentData[step.field] = text.trim()
        }
        
        this.agentStep++
        if (this.agentStep < steps.length) {
          return steps[this.agentStep].prompt
        } else {
          try {
            const agentData = {
              name: this.agentData.name,
              role: this.agentData.role || 'Custom',
              description: this.agentData.description || `Created via Atlas: ${this.agentData.name}`,
              capabilities: this.agentData.capabilities.length > 0 ? this.agentData.capabilities : ['chat']
            }
            const response = await api.post('/agents', agentData)
            this.creatingAgent = false
            this.agentStep = 0
            return `✅ **Agent "${response.data.name}" created successfully!**

**Details:**
• Role: ${response.data.role || 'Custom'}
• Description: ${response.data.description}
• Capabilities: ${response.data.capabilities?.join(', ') || 'chat'}

You can now:
• Edit its role on the Agents page
• Chat with it to perform specific tasks`
          } catch (e) {
            this.creatingAgent = false
            this.agentStep = 0
            return `❌ Failed to create agent: ${e.response?.data?.message || e.message}`
          }
        }
      }
      return "Let's try creating your agent again. Type 'create agent' to start."
    },

    // FLOW CREATION
    async handleFlowCreation(text) {
      const steps = [
        { prompt: "⚡ **Let's create a flow!**\n\nPlease enter the **Flow Name**:", field: 'name' },
        { prompt: "Add a **Description** for this flow:", field: 'description' },
        { prompt: "What **Trigger**? (manual, webhook, schedule):", field: 'trigger' }
      ]

      if (this.flowStep === 0) {
        this.flowData = { name: '', description: '', trigger: 'manual', actions: [] }
      }

      if (this.flowStep < steps.length) {
        const step = steps[this.flowStep]
        if (text.trim() === 'cancel') {
          this.creatingFlow = false
          this.flowStep = 0
          return "❌ Flow creation cancelled."
        }
        
        this.flowData[step.field] = text.trim()
        this.flowStep++
        
        if (this.flowStep < steps.length) {
          return steps[this.flowStep].prompt
        } else {
          this.waitingForActionType = true
          return "📧 Would you like to add an **Action** to this flow? (yes/no)"
        }
      } else {
        // After trigger, ask about action
        const lowerText = text.toLowerCase()
        if (lowerText === 'yes') {
          this.waitingForActionType = false
          this.addingAction = true
          this.actionStep = 0
          return this.getActionTypePrompt()
        } else if (lowerText === 'no') {
          this.waitingForActionType = false
          return await this.createFlow()
        } else {
          return "Please answer **yes** or **no**."
        }
      }
    },

    // ACTION CREATION - Step by Step
    getActionTypePrompt() {
      return `📧 **Add Action**

Select action type:
1. Email
2. Slack
3. Webhook

Type \`email\`, \`slack\`, or \`webhook\``
    },

    async handleActionCreation(text) {
      const lowerText = text.toLowerCase()
      
      // Handle "yes" after action added
      if (lowerText === 'yes' && this.actionStep === 99) {
        this.actionStep = 0
        return this.getActionTypePrompt()
      }
      
      if (lowerText === 'no' && this.actionStep === 99) {
        this.addingAction = false
        this.actionStep = 0
        return await this.createFlow()
      }

      if (this.actionStep === 0) {
        // Select action type
        if (['email', 'slack', 'webhook'].includes(lowerText)) {
          this.actionData.type = lowerText
          this.actionData.subject = ''
          this.actionData.to = ''
          this.actionData.webhook = ''
          this.actionData.message = ''
          this.actionStep++
          
          if (lowerText === 'email') {
            return "📧 **Email Action**\n\nEnter the recipient email address:"
          } else if (lowerText === 'slack') {
            return "💬 **Slack Action**\n\nEnter the Slack webhook URL:"
          } else if (lowerText === 'webhook') {
            return "🔗 **Webhook Action**\n\nEnter the webhook URL:"
          }
        } else {
          return "❌ Invalid action type. Please type: `email`, `slack`, or `webhook`"
        }
      } else if (this.actionStep === 1) {
        // Enter recipient/webhook URL
        if (this.actionData.type === 'email') {
          this.actionData.to = text.trim()
          this.actionStep++
          return "📝 Enter the email **Subject**:"
        } else if (this.actionData.type === 'slack') {
          this.actionData.webhook = text.trim()
          this.actionStep++
          return "📝 Enter the **Message** to send to Slack (DeepSeek will rewrite it):"
        } else if (this.actionData.type === 'webhook') {
          this.actionData.webhook = text.trim()
          this.actionStep++
          return "📝 Enter the **Data** to send (JSON format, e.g., {\"key\":\"value\"}):"
        }
      } else if (this.actionStep === 2) {
        if (this.actionData.type === 'email') {
          this.actionData.subject = text.trim()
          this.actionStep++
          return "📝 Enter the email **Body** (DeepSeek will rewrite it professionally):"
        } else if (this.actionData.type === 'slack') {
          this.actionData.message = text.trim()
          const rewritten = await this.rewriteWithDeepSeek(this.actionData.message, 'slack')
          this.actionData.message = rewritten
          return await this.confirmAction()
        } else if (this.actionData.type === 'webhook') {
          this.actionData.message = text.trim()
          return await this.confirmAction()
        }
      } else if (this.actionStep === 3) {
        if (this.actionData.type === 'email') {
          this.actionData.message = text.trim()
          const rewritten = await this.rewriteWithDeepSeek(this.actionData.message, 'email')
          this.actionData.message = rewritten
          return await this.confirmAction()
        }
      }
      return "Let's try adding your action again."
    },

    async rewriteWithDeepSeek(text, type) {
      try {
        const prompt = type === 'email' 
          ? `Rewrite this email body to be professional and clear. Keep the original meaning but make it more polished:\n\n"${text}"`
          : `Rewrite this Slack message to be professional and clear:\n\n"${text}"`
        
        const response = await api.post('/atlas/chat', { message: `Please rewrite this message professionally: "${text}"` })
        return response.data.response || text
      } catch (e) {
        console.error('DeepSeek rewrite failed:', e)
        return text
      }
    },

    async confirmAction() {
      const action = this.actionData
      let details = ''
      if (action.type === 'email') {
        details = `📧 **Email Action**
• To: ${action.to}
• Subject: ${action.subject}
• Body: ${action.message}`
      } else if (action.type === 'slack') {
        details = `💬 **Slack Action**
• Webhook: ${action.webhook}
• Message: ${action.message}`
      } else if (action.type === 'webhook') {
        details = `🔗 **Webhook Action**
• URL: ${action.webhook}
• Data: ${action.message}`
      }
      
      this.actionStep = 99 // Special step for confirm
      return `${details}

Add this action to the flow? (yes/no)`
    },

    async saveAction() {
      const action = this.actionData
      let config = {}
      if (action.type === 'email') {
        config = { to: action.to, subject: action.subject, body: action.message }
      } else if (action.type === 'slack') {
        config = { webhook: action.webhook, message: action.message }
      } else if (action.type === 'webhook') {
        config = { url: action.webhook, data: action.message }
      }
      
      this.flowData.actions.push({
        type: action.type,
        label: `Send ${action.type.charAt(0).toUpperCase() + action.type.slice(1)}`,
        config: config
      })
      
      this.actionData = { type: '', to: '', webhook: '', message: '', subject: '' }
      this.actionStep = 0
      
      return "✅ Action added successfully! Would you like to add another action? (yes/no)"
    },

    async createFlow() {
      try {
        const flowData = {
          name: this.flowData.name,
          description: this.flowData.description || `Created via Atlas: ${this.flowData.name}`,
          dag: { steps: this.flowData.actions },
          triggers: [this.flowData.trigger || 'manual'],
          status: 'draft'
        }
        const response = await api.post('/flows', flowData)
        this.creatingFlow = false
        this.flowStep = 0
        this.addingAction = false
        this.actionStep = 0
        const actionCount = this.flowData.actions.length
        return `✅ **Flow "${response.data.name}" created successfully!**

**Details:**
• Description: ${response.data.description}
• Trigger: ${response.data.triggers?.[0] || 'manual'}
• Actions: ${actionCount > 0 ? actionCount : 'No actions yet'}

${actionCount > 0 ? '• Actions configured: ' + this.flowData.actions.map(a => a.type).join(', ') : ''}

You can now:
• Add more actions from the Flows page
• Click Execute to run it`
      } catch (e) {
        this.creatingFlow = false
        this.flowStep = 0
        this.addingAction = false
        this.actionStep = 0
        return `❌ Failed to create flow: ${e.response?.data?.message || e.message}`
      }
    },

    // PROCESS COMMANDS
    async processCommand(text) {
      const lower = text.toLowerCase()
      const trimmed = text.trim()

      if (lower === 'create agent') {
        this.creatingAgent = true
        this.agentStep = 0
        return "🤖 **Let's create an agent!**\n\nPlease enter the **Agent Name**:"
      }

      if (lower === 'create flow') {
        this.creatingFlow = true
        this.flowStep = 0
        return "⚡ **Let's create a flow!**\n\nPlease enter the **Flow Name**:"
      }

      if (lower === '/agents') {
        try {
          const { data } = await api.get('/agents')
          if (!data || data.length === 0) {
            return '📋 No agents yet. Type "create agent" to create one!'
          }
          let response = '**📋 Your Agents:**\n'
          data.forEach(a => {
            response += `• ${a.name} (${a.role || 'Custom'}) - ${a.status}\n`
          })
          return response
        } catch(e) {
          return '❌ Failed to fetch agents: ' + (e.response?.data?.message || e.message)
        }
      }

      if (lower === '/flows') {
        try {
          const { data } = await api.get('/flows')
          if (!data || data.length === 0) {
            return '📋 No flows yet. Type "create flow" to create one!'
          }
          let response = '**📋 Your Flows:**\n'
          data.forEach(f => {
            const stepCount = f.dag?.steps?.length || 0
            response += `• ${f.name} (${f.status}) - ${stepCount} steps\n`
          })
          return response
        } catch(e) {
          return '❌ Failed to fetch flows: ' + (e.response?.data?.message || e.message)
        }
      }

      if (lower === '/help') {
        return this.getWelcomeMessage()
      }

      if (lower === '/status') {
        try {
          const [agents, flows] = await Promise.all([
            api.get('/agents'),
            api.get('/flows')
          ])
          return `📊 **System Status**
• Agents: ${agents.data.length}
• Flows: ${flows.data.length}
• System: Online
• AI: DeepSeek (ModelArk BytePlus)`
        } catch(e) {
          return '📊 **System Status**\n• System: Online\n• AI: DeepSeek'
        }
      }

      return "I'm here to help! Try '/help' to see available commands."
    }
  }
}
</script>

<style scoped>
.atlas-container {
  padding: 2rem;
  max-width: 1200px;
  margin: 0 auto;
  min-height: 100vh;
}
.page-header {
  margin-bottom: 2rem;
}
.page-header h1 {
  font-size: 2rem;
  font-weight: 700;
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.page-header p {
  color: var(--text-secondary);
  font-size: 0.95rem;
  margin-top: 0.5rem;
}
.chat-wrapper {
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}
.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
  min-height: 400px;
  max-height: 500px;
}
.message {
  display: flex;
  margin-bottom: 1rem;
  gap: 0.75rem;
}
.message.user {
  flex-direction: row-reverse;
}
.message.user .bubble {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
}
.message.assistant .bubble {
  background: var(--bg-elevated);
  color: var(--text-primary);
  border: 1px solid var(--border);
}
.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  flex-shrink: 0;
  font-size: 1.1rem;
}
.bubble {
  padding: 0.75rem 1.25rem;
  border-radius: 16px;
  max-width: 75%;
  word-wrap: break-word;
  white-space: pre-wrap;
}
.bubble.typing {
  opacity: 0.6;
}
.chat-input-area {
  padding: 1rem 1.5rem;
  border-top: 1px solid var(--border);
  background: var(--bg-elevated);
}
.suggestions {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.75rem;
}
.suggestions button {
  padding: 0.3rem 0.8rem;
  border-radius: 20px;
  border: 1px solid var(--border);
  background: var(--bg-card);
  color: var(--text-primary);
  cursor: pointer;
  font-size: 0.8rem;
  transition: all 0.2s;
}
.suggestions button:hover {
  background: #3b82f6;
  border-color: #3b82f6;
  color: #fff;
}
.input-group {
  display: flex;
  gap: 0.75rem;
}
.input-group input {
  flex: 1;
  padding: 0.6rem 1rem;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--bg-card);
  color: var(--text-primary);
  outline: none;
  font-size: 0.95rem;
}
.input-group input:focus {
  border-color: #3b82f6;
}
.input-group input::placeholder {
  color: var(--text-secondary);
}
.send-btn {
  padding: 0.6rem 1.5rem;
  border-radius: 12px;
  border: none;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.send-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(59,130,246,0.3);
}
</style>
