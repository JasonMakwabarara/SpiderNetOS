<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
        <!-- PR CI: deterministic pure tests — no Postgres pgvector migrations, no Redis -->
        <testsuite name="CiFast">
            <directory suffix="Test.php">./tests/Unit/Ste</directory>
            <directory suffix="Test.php">./tests/Unit/Payments</directory>
            <directory suffix="Test.php">./tests/Unit/Billing</directory>
            <directory suffix="Test.php">./tests/Unit/Mfa</directory>
            <directory suffix="Test.php">./tests/Unit/Outreach</directory>
            <!--
                Skills joins the fast lane, not just the Postgres+Redis one.

                These tests need no database, no Redis and no network: the
                registry is a const, the corpus is on disk, and the eval runner
                touches neither. Leaving them only in the full lane meant the
                property gate ran once per PR behind two service containers —
                and a gate that runs late protects nothing in between. A 51-type
                coverage gap survived precisely because nothing here ran on push.
            -->
            <directory suffix="Test.php">./tests/Unit/Skills</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Crypt::encryptString has to work: TenantKeyManager::storeSecret encrypts
             every integration credential, and without a key the SQLite lane could
             not test any code path that stores a secret. 32 bytes: str_repeat('a', 32). -->
        <env name="APP_KEY" value="base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- config/cache.php reads CACHE_STORE (Laravel 11), not CACHE_DRIVER —
             the old name was a silent no-op that left tests hitting real Redis. -->
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="REDIS_CLIENT" value="predis"/>
        <env name="FEATURE_ATLAS_USAGE_AGGREGATES_V2" value="off"/>
    </php>
</phpunit>
