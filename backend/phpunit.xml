<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
        <!-- PR CI: deterministic pure tests — no Postgres pgvector migrations, no Redis -->
        <testsuite name="CiFast">
            <directory suffix="Test.php">./tests/Unit/Ste</directory>
            <directory suffix="Test.php">./tests/Unit/Services/Payments</directory>
            <directory suffix="Test.php">./tests/Feature/Billing</directory>
            <directory suffix="Test.php">./tests/Feature/Enterprise</directory>
            <file>./tests/Feature/TenantIsolationTest.php</file>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="REDIS_CLIENT" value="predis"/>
        <env name="FEATURE_ATLAS_USAGE_AGGREGATES_V2" value="off"/>
    </php>
</phpunit>
