<?php
namespace App\Services;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;

class AIService
{
    protected $apiKey;
    protected $model = 'gpt-3.5-turbo';

    public function __construct()
    {
        $this->apiKey = env('OPENAI_API_KEY');
    }

    public function chat($agentName, $agentDescription, $message)
    {
        if (empty($this->apiKey)) {
            Log::warning('OpenAI API key not configured');
            return "OpenAI API key not configured. Please add OPENAI_API_KEY to .env";
        }

        try {
            // Use Guzzle client directly with SSL disabled
            $client = new \GuzzleHttp\Client([
                'verify' => false,
                'timeout' => 30,
            ]);

            $response = $client->post('https://api.openai.com/v1/chat/completions', [
                'headers' => [
                    'Authorization' => 'Bearer ' . $this->apiKey,
                    'Content-Type' => 'application/json',
                ],
                'json' => [
                    'model' => $this->model,
                    'messages' => [
                        ['role' => 'system', 'content' => "You are {$agentName}, an AI assistant. {$agentDescription}. Keep responses helpful and concise."],
                        ['role' => 'user', 'content' => $message]
                    ],
                    'max_tokens' => 200,
                    'temperature' => 0.7,
                ]
            ]);

            $body = json_decode($response->getBody(), true);
            if (isset($body['choices'][0]['message']['content'])) {
                return $body['choices'][0]['message']['content'];
            }

            Log::error('OpenAI API error', ['response' => $body]);
            return "I'm having trouble connecting to AI. Please try again later.";

        } catch (\GuzzleHttp\Exception\RequestException $e) {
            Log::error('OpenAI API exception', ['message' => $e->getMessage()]);
            
            // Check if it's an SSL error
            if (strpos($e->getMessage(), 'SSL') !== false) {
                return "SSL Error: Unable to verify SSL certificate. This is a local development issue. Please try using the chat in the browser.";
            }
            
            return "I'm having trouble connecting to AI. Error: " . $e->getMessage();
        } catch (\Exception $e) {
            Log::error('OpenAI API general exception', ['message' => $e->getMessage()]);
            return "I'm having trouble connecting to AI. Error: " . $e->getMessage();
        }
    }
}
