{
  "_comment": "Canonical schema contract for STE projection tables (plan §12).",
  "tables": {
    "ste_transitions": {
      "columns": {
        "id":            { "type": "bigint",      "nullable": false },
        "chain":         { "type": "varchar",     "nullable": false },
        "from_state":    { "type": "varchar",     "nullable": false },
        "to_state":      { "type": "varchar",     "nullable": false },
        "tags":          { "type": "jsonb",       "nullable": false },
        "tenant_id":     { "type": "uuid",        "nullable": true  },
        "count":         { "type": "bigint",      "nullable": false, "default": "0" },
        "last_seen_at":  { "type": "timestamp",   "nullable": false }
      }
    },
    "ste_session_states": {
      "columns": {
        "session_id":        { "type": "uuid",      "nullable": false },
        "tenant_id":         { "type": "uuid",      "nullable": false },
        "current_state":     { "type": "varchar",   "nullable": false },
        "last_state":        { "type": "varchar",   "nullable": true  },
        "entered_at":        { "type": "timestamp", "nullable": false },
        "updated_at":        { "type": "timestamp", "nullable": false },
        "last_sequence_num": { "type": "bigint",    "nullable": false }
      }
    },
    "ste_tenant_states": {
      "columns": {
        "tenant_id":         { "type": "uuid",      "nullable": false },
        "current_state":     { "type": "varchar",   "nullable": false },
        "last_state":        { "type": "varchar",   "nullable": true  },
        "entered_at":        { "type": "timestamp", "nullable": false },
        "updated_at":        { "type": "timestamp", "nullable": false },
        "last_sequence_num": { "type": "bigint",    "nullable": false }
      }
    },
    "ste_event_mapping": {
      "columns": {
        "id":           { "type": "bigint",    "nullable": false },
        "event_type":   { "type": "varchar",   "nullable": false },
        "chain":        { "type": "varchar",   "nullable": false },
        "from_state":   { "type": "varchar",   "nullable": true  },
        "to_state":     { "type": "varchar",   "nullable": false },
        "extract_tags": { "type": "jsonb",     "nullable": false },
        "enabled":      { "type": "boolean",   "nullable": false },
        "created_at":   { "type": "timestamp", "nullable": false }
      }
    },
    "ste_unmapped_events": {
      "columns": {
        "id":              { "type": "bigint",    "nullable": false },
        "event_type":      { "type": "varchar",   "nullable": false },
        "sample_event_id": { "type": "uuid",      "nullable": false },
        "tenant_id":       { "type": "uuid",      "nullable": false },
        "first_seen_at":   { "type": "timestamp", "nullable": false },
        "count":           { "type": "bigint",    "nullable": false }
      }
    }
  }
}
