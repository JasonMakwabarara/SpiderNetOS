{
  "name": "spidernet-os",
  "version": "3.2.0",
  "private": true,
  "description": "SpiderNet OS — Multi-tenant AI Operating System",
  "workspaces": [
    "cockpit",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "codegen": "node tools/dev/codegen.js",
    "training:gate:atlas": "powershell -ExecutionPolicy Bypass -File scripts/training-gate.ps1",
    "mcp:build": "cd services/mcp-server && npm run build",
    "mcp:start": "powershell -ExecutionPolicy Bypass -File scripts/start-mcp-server.ps1",
    "mcp:inspect": "cd services/mcp-server && npm run inspect"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
