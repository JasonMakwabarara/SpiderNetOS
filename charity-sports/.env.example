# Charity Sports server settings.
# Copy this file to .env and fill it in. Never commit .env.
#
# The public website does NOT need any of this. It is plain static files and
# works on GitHub Pages with no server at all. Everything here is for running
# the admin panel.

# ---------------------------------------------------------------- essentials
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Signs the session cookie. REQUIRED in production, at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everybody out. Keep it secret.
SESSION_SECRET=

# ------------------------------------------------------------------ storage
# These two MUST point at a persistent disk. On a host with a temporary
# filesystem (the default on Render and Railway free tiers) every content
# edit, uploaded logo, account and audit entry is lost on the next restart.
CONTENT_DIR=/data/content
UPLOAD_DIR=/data/uploads

# Where the site refers to uploaded files. Leave this alone unless you have
# moved the assets folder.
UPLOAD_URL_BASE=assets/img/uploads

# ------------------------------------------------------------------- behind
# Set to 1 when something else terminates TLS in front of this server
# (Render, Railway, Fly, nginx, Caddy). Without it the server sees every
# request as plain HTTP, so secure cookies and rate limiting by address
# both misbehave.
TRUST_PROXY=1
COOKIE_SECURE=true

# ------------------------------------------------------------------ sessions
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=168

# --------------------------------------------------------------- login abuse
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_LOCK_MINUTES=240
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_LOGIN_PER_15=20

# Sign-ups allowed per minute from one internet address. Kept generous because
# many Zimbabwean mobile users share an address, and a room full of people
# signing up at an event must not lock each other out.
SIGNUP_RATE_PER_MIN=10

# ------------------------------------------------------------------ uploads
UPLOAD_MAX_BYTES=8388608

# Uploaded SVGs are converted to PNG and the original discarded, which
# removes any script inside them. Set to true only if you genuinely need
# vector logos and understand that an SVG is a document that can run code.
ALLOW_SVG_UPLOAD=false

# --------------------------------------------------------------------- CORS
# Sites allowed to read /api/content from a different address. Set this to
# your GitHub Pages URL if the public site is hosted separately from this
# server and you want it to pick up edits without a publish.
# Comma separated, no trailing slash.
CORS_ORIGINS=

# ------------------------------------------------------------------ publish
# file   write the snapshot on this server only (default)
# github commit it through the GitHub API, so GitHub Pages rebuilds
# git    commit and push with the local git command
PUBLISH_TARGET=file

# Only for PUBLISH_TARGET=github. Use a fine-grained token limited to this one
# repository with Contents: read and write. Nothing else.
GITHUB_TOKEN=
GITHUB_REPO=JasonMakwabarara/charity-sports
GITHUB_BRANCH=main

# Used for absolute links in the structured data. Falls back to the site URL
# stored in the content.
SITE_URL=https://jasonmakwabarara.github.io/charity-sports/

# ------------------------------------------------------------------ logging
# error | warn | info | debug
LOG_LEVEL=info
