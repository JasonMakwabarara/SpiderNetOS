{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spidernet.io/schemas/feature-pack/v1",
  "title": "SpiderNetOS Feature Pack",
  "description": "Schema for Feature Pack manifests (pack.yaml)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["spidernet/v1"],
      "description": "API version for schema compatibility"
    },
    "kind": {
      "type": "string",
      "enum": ["FeaturePack"],
      "description": "Resource type"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "version", "vertical"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Unique pack identifier (kebab-case)"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version"
        },
        "vertical": {
          "type": "string",
          "description": "Industry vertical classification"
        },
        "displayName": {
          "type": "string",
          "description": "Human-readable name"
        },
        "description": {
          "type": "string",
          "description": "Short description of the pack"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["requires", "provides"],
      "properties": {
        "requires": {
          "type": "object",
          "properties": {
            "core_agents": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["atlas", "hannah", "forge", "sentinel", "prism", "nexus"]
              },
              "description": "Required core agents"
            },
            "min_spidernet_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Minimum SpiderNetOS version"
            }
          }
        },
        "provides": {
          "type": "object",
          "properties": {
            "dynamic_agents": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  },
                  "displayName": { "type": "string" },
                  "capabilities": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            },
            "flows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "description": { "type": "string" }
                }
              }
            },
            "ste_chains": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  },
                  "description": { "type": "string" },
                  "states": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["metric", "goal"],
                "properties": {
                  "metric": { "type": "string" },
                  "goal": { "type": "string" },
                  "baseline": { "type": "number" }
                }
              }
            }
          }
        },
        "config": {
          "type": "object",
          "properties": {
            "default_automation_level": {
              "type": "string",
              "enum": ["manual", "assisted", "autonomous"]
            },
            "enable_cross_tenant_learning": {
              "type": "boolean"
            }
          }
        },
        "signatures": {
          "type": "object",
          "properties": {
            "publisher": { "type": "string" },
            "signature": { "type": "string" }
          }
        },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from"],
            "properties": {
              "from": { "type": "string" },
              "hooks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "enum": ["sql", "event"] },
                    "script": { "type": "string" },
                    "emit": { "type": "string" },
                    "payload": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
